# Add one key or a comma-separated pool of keys for each provider.
# Keys stay on the server and must never use a NEXT_PUBLIC_ prefix.
GOOGLE_API_KEYS=
GOOGLE_API_KEY=
GEMINI_API_KEY=

ANTHROPIC_API_KEYS=
ANTHROPIC_API_KEY=

OPENAI_API_KEYS=
OPENAI_API_KEY=

GROQ_API_KEYS=
GROQ_API_KEY=

NVIDIA_API_KEYS=
NVIDIA_API_KEY=

# Optional fallback for ASME-related web research when laptop PDF evidence is unavailable or insufficient.
TAVILY_API_KEY=

# Laptop-side credentials belong only in Laptop/.env.local.
# Set the laptop service's public HTTPS tunnel URL and matching token here.
ASME_LAPTOP_RETRIEVAL_URL=
ASME_LAPTOP_RETRIEVAL_TOKEN=

# Required: use the same Supabase project used for Nova AI authentication.
# The anon key is a public project key, but keep this server-side in this app.
NOVA_SUPABASE_URL=https://unlqaxcgdxjixlvvuuvy.supabase.co
NOVA_SUPABASE_ANON_KEY=
